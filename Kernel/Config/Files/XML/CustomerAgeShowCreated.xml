<?xml version="1.0" encoding="utf-8" ?>
<otobo_config version="2.0" init="Application">
    <Setting Name="TimeShowCreatedAt" Required="0" Valid="0">
        <Description Translatable="1">Shows creation date instead of age if ticket is older than configured value (days).</Description>
        <Navigation>Core::Time</Navigation>
        <Value>
            <Item ValueType="Select" SelectedID="1">
                <Item ValueType="Option" Value="1" Translatable="1">1 day</Item>
                <Item ValueType="Option" Value="2" Translatable="1">2 days</Item>
                <Item ValueType="Option" Value="7" Translatable="1">7 days</Item>
                <Item ValueType="Option" Value="30" Translatable="1">30 days</Item>
            </Item>
        </Value>
    </Setting>
    <Setting Name="AutoloadPerlPackages###2000-CustomerAgeSwitch" Required="0" Valid="1">
        <Description Translatable="1">Return formatted Create date instead of Age if configured treshold age is surpassed.</Description>
        <Navigation>Core::Autoload</Navigation>
        <Value>
            <Array>
                <Item ValueType="String">Kernel::Autoload::CustomerAgeSwitch</Item>
            </Array>
        </Value>
    </Setting>
</otobo_config>
